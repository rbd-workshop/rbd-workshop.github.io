  "topics": [
    {
      "title": "Representation & indexing",
      "question": "How do we represent what a capability can do?",
      "description": "Represent tools, APIs, skills, workflows, memories, models, and agents through language, schemas, code, demonstrations, traces, graphs, and embeddings.",
      "tags": [
        "Capability representations",
        "Dynamic indexes",
        "Graphs & ontologies"
      ]
    },
    {
      "title": "Retrieval, routing & composition",
      "question": "Which capabilities work best together?",
      "description": "Retrieve and route across capability types, accounting for dependencies, compatibility, permissions, reliability, and cost. Compose the right set for the task.",
      "tags": [
        "Joint retrieval",
        "Agent routing",
        "Compatibility"
      ]
    },
    {
      "title": "Retrieval in the agent loop",
      "question": "What should an agent retrieve next?",
      "description": "Condition retrieval on execution state, plans, and observations. Study reformulation, clarification, decomposition, invocation, delegation, replanning, recovery, and abstention.",
      "tags": [
        "State-aware retrieval",
        "Planning",
        "Recovery"
      ]
    },
    {
      "title": "Action-grounded evaluation",
      "question": "Did the retrieved capability actually help?",
      "description": "Evaluate retrieval, incorporation, invocation, composition, and execution. Develop complete-set and dependency-aware metrics, calibration, and resource-constrained evaluation.",
      "tags": [
        "Downstream success",
        "Benchmarks",
        "Calibration"
      ]
    },
    {
      "title": "Ecosystems & deployment",
      "question": "How does capability retrieval work in the wild?",
      "description": "Build dynamic, federated, and access-controlled registries. Explore Model Context Protocol ecosystems, provenance, permissions, freshness, observability, caching, and reliability.",
      "tags": [
        "MCP ecosystems",
        "Provenance",
        "Production systems"
      ]
    }
  ],
